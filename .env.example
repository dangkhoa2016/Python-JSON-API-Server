# Server
APP_ENV=development
DEBUG_SQL=false
PORT=3000

# Database
DB_PATH=./storage/data.db

# Redis (optional — rate limiting falls back to in-memory if unavailable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Comma-separated IPs/CIDRs that may set X-Forwarded-For / X-Real-IP.
# Defaults to loopback only; add your proxy ranges when behind a reverse proxy.
TRUSTED_PROXIES=127.0.0.1,::1

# Admin API
ADMIN_KEY=

# Pagination and body size
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
MAX_BODY_SIZE=1048576

# Seed data source
SEED_API_BASE_URL=https://jsonplaceholder.typicode.com

# Container bootstrap controls (not persisted as runtime settings)
# Seed remote demo data during container startup.
# Accepted true values: 1, true, TRUE, yes, YES. Accepted false values: 0, false, FALSE, no, NO, empty/unset.
SEED_DATA_ON_STARTUP=false
# Total timeout in seconds for the opt-in demo data seed; the container fails if it expires.
SEED_TIMEOUT_SECONDS=60
